<div
  style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; padding: 30px; color: #333; max-width: 500px; margin: auto; border: 1px solid #eee; border-radius: 10px;"
>
  <div style='text-align: center; margin-bottom: 25px;'>
    <img src='cid:logo' alt='Company Logo' style='width: 70px; height: auto;' />
  </div>

  <h2
    style='text-align: center; color: #1a1a1a; margin-bottom: 10px;'
  >Verification Code</h2>
  <p style='text-align: center; color: #666; font-size: 16px;'>Please use the
    following code to complete your verification. This code is valid for
    <b>10 minutes</b>.</p>

  <div style='text-align: center; margin: 30px 0;'>
    <div
      style='display: inline-block; padding: 15px 30px; background-color: #f4f7ff; border: 2px dashed #4A90E2; border-radius: 8px;'
    >
      <span
        style='font-size: 32px; font-weight: bold; letter-spacing: 8px; color: #4A90E2;'
      >{{otp}}</span>
    </div>
  </div>

  <p
    style='font-size: 14px; color: #888; text-align: center; line-height: 1.5;'
  >
    If you didn't request this code, you can safely ignore this email. Someone
    may have typed your email address by mistake.
  </p>

  <hr style='border: 0; border-top: 1px solid #eee; margin: 20px 0;' />
  <div style='text-align: left;'>
    <img
      src='cid:logo'
      alt='Company Logo'
      style='width: 100px; height: auto;'
    />
    <p style='font-size: 12px; color: #999;'>© {{year}} {{company}}.</p>
  </div>
</div>