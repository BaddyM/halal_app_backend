generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

enum UserRole {
    admin
    office
    sales_rep
}

enum ProductCategory {
    exams
    workbooks
    holiday_packages
}

enum ExpenseCategory {
    transport
    meals
    supplies
    other
}

enum NotificationType {
    info
    warning
    success
    error
}

enum StockTakeStatus {
    active
    completed
}

model Branch {
    id           String        @id @default(uuid())
    name         String        @unique
    address      String?
    contact      String?
    isActive     Boolean       @default(false)
    createdAt    DateTime      @default(now())
    updatedAt    DateTime      @default(now()) @updatedAt
    users        User[]
    receipts     Receipt[]
    customers    Customer[]
    dailyReports DailyReport[]
    staff        Staff[]
}

model User {
    id                  String          @id @default(uuid())
    name                String
    email               String          @unique
    accessToken         String?
    password            String
    role                UserRole
    isActive            Boolean         @default(false)
    branchId            String?
    createdAt           DateTime        @default(now())
    updatedAt           DateTime        @default(now()) @updatedAt
    branch              Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
    sales               Sale[]
    receipts            Receipt[]
    expenses            Expense[]
    targetNotifications Notification[]  @relation("TargetUser")
    loginAccesses       LoginAccess[]
    creditSales         CreditSale[]
    creditPayments      CreditPayment[]
    dailyReports        DailyReport[]
    settings            Settings[]
    salaries            Salary[]
    stockTakeItems      StockTakeItem[]
}

model Customer {
    id          String   @id @default(uuid())
    name        String
    email       String?
    phoneNumber String
    address     String?
    branchId    String
    isDeleted   Boolean  @default(false)
    branch      Branch   @relation(fields: [branchId], references: [id])
    createdAt   DateTime @default(now())
    updatedAt   DateTime @default(now()) @updatedAt
    sales       Sale[]
}

model DailyReport {
    id        String   @id @default(uuid())
    branchId  String
    branch    Branch   @relation(fields: [branchId], references: [id])
    notes     String   @db.LongText
    userId    String
    user      User     @relation(fields: [userId], references: [id])
    isDeleted Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt
}

model LoginAccess {
    id        String   @id @default(uuid())
    userId    String
    user      User     @relation(fields: [userId], references: [id])
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt
}

model Product {
    id             String          @id @default(uuid())
    category       ProductCategory
    price          Float
    totalStock     Int
    classLevel     String?
    subject        String?
    createdAt      DateTime        @default(now())
    updatedAt      DateTime        @default(now()) @updatedAt
    stockTakeItems StockTakeItem[]
    sales          Sale[]
}

model StockTakeItem {
    id                     String                 @id @default(uuid())
    userId                 String
    user                   User                   @relation(fields: [userId], references: [id])
    productId              String
    quantityTaken          Int
    quantitySold           Int                    @default(0)
    quantityReturned       Int                    @default(0)
    revenue                Float                  @default(0)
    product                Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
    createdAt              DateTime               @default(now())
    updatedAt              DateTime               @default(now()) @updatedAt
    stockTakeItemHistories StockTakeItemHistory[]

    @@unique([userId, productId])
}

model StockTakeItemHistory {
    id              String        @id @default(uuid())
    stockTakeItemId String
    stockTakeItem   StockTakeItem @relation(fields: [stockTakeItemId], references: [id])
    createdAt       DateTime      @default(now())
    updatedAt       DateTime      @default(now()) @updatedAt
}

model Sale {
    id          String    @id @default(uuid())
    orderId     String
    repId       String
    stockTakeId String?
    productId   String
    quantity    Int
    customerId  String?
    customer    Customer? @relation(fields: [customerId], references: [id])
    unitPrice   Float
    memo        String?   @db.LongText
    onCredit    Boolean   @default(false)
    createdAt   DateTime  @default(now())
    updatedAt   DateTime  @default(now()) @updatedAt
    rep         User      @relation(fields: [repId], references: [id], onDelete: Cascade)
    product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
    receipts    Receipt[]
}

model CreditSale {
    id             String           @id @default(uuid())
    orderId        String
    amount         Float
    userId         String
    user           User             @relation(fields: [userId], references: [id])
    isDeleted      Boolean          @default(false)
    status         CreditSaleStatus @default(PENDING)
    createdAt      DateTime         @default(now())
    updatedAt      DateTime         @default(now()) @updatedAt
    creditPayments CreditPayment[]
}

enum CreditSaleStatus {
    PENDING
    COMPLETED
    CANCELLED
}

model CreditPayment {
    id           String     @id @default(uuid())
    creditSaleId String
    creditSale   CreditSale @relation(fields: [creditSaleId], references: [id])
    paid         Float
    userId       String
    user         User       @relation(fields: [userId], references: [id])
    createdAt    DateTime   @default(now())
    updatedAt    DateTime   @default(now()) @updatedAt
}

model Receipt {
    id        String   @id @default(uuid())
    saleId    String
    repId     String
    branchId  String
    image     String
    createdAt DateTime @default(now())
    updatedAt DateTime @default(now()) @updatedAt
    verified  Boolean  @default(false)
    sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
    rep       User     @relation(fields: [repId], references: [id], onDelete: Cascade)
    branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model Expense {
    id          String          @id @default(uuid())
    userId      String
    description String?
    amount      Float
    category    ExpenseCategory
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @default(now()) @updatedAt
    user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
    id           String           @id @default(uuid())
    title        String
    message      String
    type         NotificationType @default(info)
    targetUserId String?
    read         Boolean          @default(false)
    createdAt    DateTime         @default(now())
    updatedAt    DateTime         @default(now()) @updatedAt
    targetUser   User?            @relation("TargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)
}

model Staff {
    id         String   @id @default(uuid())
    name       String
    phone      String
    email      String?
    address    String?
    role       String
    baseSalary Float
    branchId   String
    branch     Branch   @relation(fields: [branchId], references: [id])
    createdAt  DateTime @default(now())
    updatedAt  DateTime @default(now()) @updatedAt
    salaries   Salary[]
}

model Salary {
    id        String       @id @default(uuid())
    staffId   String
    staff     Staff        @relation(fields: [staffId], references: [id])
    period    String
    amount    Float
    userId    String
    user      User         @relation(fields: [userId], references: [id])
    status    SalaryStatus @default(PENDING)
    memo      String?      @db.LongText
    createdAt DateTime     @default(now())
    updatedAt DateTime     @default(now()) @updatedAt
}

enum SalaryStatus {
    PENDING
    COMPLETED
    CANCELLED
}

model Settings {
    id                 String   @id @default(uuid())
    emailNotifications Boolean  @default(false)
    userId             String
    user               User     @relation(fields: [userId], references: [id])
    createdAt          DateTime @default(now())
    updatedAt          DateTime @default(now()) @updatedAt
}

model Supplier {
    id               String            @id @default(uuid())
    name             String
    contact          String?
    email            String?
    address          String?
    memo             String?           @db.LongText
    createdAt        DateTime          @default(now())
    updatedAt        DateTime          @default(now()) @updatedAt
    supplierProducts SupplierProduct[]
    purchaseOrders   PurchaseOrder[]
}

model SupplierProduct {
    id             String          @id @default(uuid())
    supplierId     String
    name           String
    price          Float
    memo           String?         @db.LongText
    createdAt      DateTime        @default(now())
    updatedAt      DateTime        @default(now()) @updatedAt
    supplier       Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
    purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
    id            String                     @id @default(uuid())
    orderId       String
    supplierId    String
    productId     String
    quantity      Int
    unitPrice     Float
    totalPrice    Float
    amountPaid    Float                      @default(0)
    amountDue     Float                      @default(0)
    paymentTerms  PurchaseOrderPaymentTerms  @default(FULL)
    paymentStatus PurchaseOrderPaymentStatus @default(UNPAID)
    status        PurchaseOrderStatus        @default(PENDING)
    createdAt     DateTime                   @default(now())
    updatedAt     DateTime                   @default(now()) @updatedAt
    supplier      Supplier                   @relation(fields: [supplierId], references: [id], onDelete: Cascade)
    product       SupplierProduct            @relation(fields: [productId], references: [id], onDelete: Cascade)
    payments      PurchaseOrderPayment[]
}

model PurchaseOrderPayment {
    id              String                     @id @default(uuid())
    purchaseOrderId String
    amount          Float
    method          PurchaseOrderPaymentMethod @default(CASH)
    reference       String?
    note            String?                    @db.LongText
    paidAt          DateTime                   @default(now())
    createdAt       DateTime                   @default(now())
    updatedAt       DateTime                   @default(now()) @updatedAt
    purchaseOrder   PurchaseOrder              @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

    @@index([purchaseOrderId])
}

enum PurchaseOrderStatus {
    PENDING
    RECEIVED
    CANCELLED
}

enum PurchaseOrderPaymentTerms {
    FULL
    CREDIT
}

enum PurchaseOrderPaymentStatus {
    UNPAID
    PARTIALLY_PAID
    PAID
}

enum PurchaseOrderPaymentMethod {
    CASH
    BANK_TRANSFER
    MOBILE_MONEY
    CHEQUE
    OTHER
}
