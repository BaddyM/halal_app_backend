generator client {
    provider = "prisma-client-js"
    //   output   = "../generated/prisma"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

model User {
    id                   String            @id @default(uuid())
    firstName            String
    lastName             String
    phoneNumber          String
    gender               String
    nationalId           String?
    dob                  String?
    maritalStatus        String?
    streetAddress        String?
    city                 String
    district             String
    occupation           String?
    secondaryPhoneNumber String?
    email                String?           @unique
    password             String
    role                 Role
    profilePicture       String?
    isActive             Boolean           @default(false)
    accessToken          String?
    fcmToken             String?
    createdAt            DateTime          @default(now())
    updatedAt            DateTime          @updatedAt
    loginAccesses        LoginAccess[]
    targets              Target[]
    documents            Document[]
    news                 News[]
    settings             Settings[]
    otpVerifications     OtpVerification[]
    notifications        Notifications[]
}

enum Role {
    ADMIN
    SUPER_ADMIN
    MOBILE_APP
    NORMAL_USER
}

model OtpVerification {
    id        String   @id @default(uuid())
    userId    String
    user      User     @relation(fields: [userId], references: [id])
    otp       Int
    expiresAt DateTime
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Document {
    id           String         @id @default(uuid())
    userId       String
    user         User           @relation(fields: [userId], references: [id])
    documentType DocumentType
    name         String
    status       DocumentStatus @default(PENDING)
    createdAt    DateTime       @default(now())
    updatedAt    DateTime       @updatedAt
}

enum DocumentType {
    NATIONAL_ID
    PASSPORT_PHOTO
}

enum DocumentStatus {
    PENDING
    APPROVED
    REJECTED
}

model LoginAccess {
    id        String   @id @default(uuid())
    userId    String
    user      User     @relation(fields: [userId], references: [id])
    device    String?  @db.LongText
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Target {
    id           String              @id @default(uuid())
    userId       String
    user         User                @relation(fields: [userId], references: [id])
    targetLabel  String?
    amount       Float               @default(0.0)
    status       TargetStatus        @default(PENDING)
    isDeleted    Boolean             @default(false)
    createdAt    DateTime            @default(now())
    updatedAt    DateTime            @updatedAt
    transactions TargetTransaction[]
}

enum TargetStatus {
    PENDING
    ACTIVE
    INACTIVE
}

enum TargetTransactionStatus {
    PENDING
    APPROVED
    REJECTED
}

model TargetTransaction {
    id            String                  @id @default(uuid())
    targetId      String
    target        Target                  @relation(fields: [targetId], references: [id])
    amount        Float                   @default(0.0)
    reason        TransactionReason
    status        TargetTransactionStatus @default(PENDING)
    paymentMethod String?
    balance       Float                   @default(0.0)
    isDeleted     Boolean                 @default(false)
    createdAt     DateTime                @default(now())
    updatedAt     DateTime                @updatedAt
}

enum TransactionReason {
    DEBIT
    CREDIT
}

model NewsLetter {
    id        String   @id @default(uuid())
    title     String
    message   String   @db.LongText
    emails    String   @db.LongText
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model News {
    id         String   @id @default(uuid())
    title      String
    message    String   @db.LongText
    tag        String?
    isFeatured Boolean  @default(false)
    userId     String
    user       User     @relation(fields: [userId], references: [id])
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt
}

model Socials {
    id        String   @id @default(uuid())
    title     String
    url       String   @db.LongText
    icon      String
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Notifications {
    id        String   @id @default(uuid())
    title     String
    message   String
    userId    String
    user      User     @relation(fields: [userId], references: [id])
    read      Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Settings {
    id                 String   @id @default(uuid())
    userId             String
    user               User     @relation(fields: [userId], references: [id])
    emailNotifications Boolean  @default(false)
    smsNotifications   Boolean  @default(false)
    pushNotifications  Boolean  @default(false)
    newsLetter         Boolean  @default(false)
    twoFa              Boolean  @default(false)
    loginAlerts        Boolean  @default(false)
    createdAt          DateTime @default(now())
    updatedAt          DateTime @updatedAt
}

model WebsiteContact {
    id             String   @id @default(uuid())
    fname          String
    lname          String
    email          String?
    phone          String
    serviceNeeded  String
    eventDate      String?
    message        String   @db.LongText
    expectedGuests String
    isRead         Boolean  @default(false)
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt
}
