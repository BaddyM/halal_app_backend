generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
//  ENUMS
// ─────────────────────────────────────────────────────────────
enum Role {
  user
  admin
}

// Granular account state for the admin dashboard. `isActive` is kept in sync
// (active/pending → true, suspended/banned → false) so existing guards/queries
// that read isActive keep working.
enum UserStatus {
  active
  pending
  suspended
  banned
}

enum Gender {
  male
  female
}

enum PrayerFrequency {
  fiveTimes
  mostPrayers
  jumuahOnly
  workingOnIt
  sometimes
  rarely
  preferNotToSay
}

enum IslamicSect {
  sunni
  shia
  sufi
  other
  preferNotToSay
}

enum HijabPreference {
  hijab
  niqab
  notApplicable
  preferNotToSay
}

enum BeardPreference {
  beard
  cleanShaven
  preferNotToSay
}

enum MarriageTimeline {
  asap
  withinYear
  oneToTwoYears
  openTimeline
}

enum ChildrenPreference {
  noWantThem
  noOpenToIt
  haveWantMore
  haveNoMore
  preferNotToSay
}

enum LocationPreference {
  sameCity
  sameCountry
  anywhere
  countryOrAbroad
}

enum SubscriptionPlan {
  basic
  premium
  vip
}

enum LikeType {
  like
  superLike
  pass
}

enum TasbihVisibility {
  private
  matchesOnly
  public
}

enum BadgeType {
  milestone     // e.g., 1k, 10k, 100k
  streak        // e.g., 7 days, 30 days
  consistency   // e.g., completed daily for N days
  special       // limited time or special events
  achievement   // unlocked via specific conditions
}

// ─────────────────────────────────────────────────────────────
//  USER & AUTH
// ─────────────────────────────────────────────────────────────
model User {
  id                String   @id @default(uuid())
  email             String   @unique
  password          String
  name              String
  phone             String?
  isEmailVerified   Boolean  @default(false)
  isPhoneVerified   Boolean  @default(false)
  isActive          Boolean  @default(true)

  // Admin / moderation
  role              Role        @default(user)
  status            UserStatus  @default(active)

  // OAuth account linkage (null for email/password accounts)
  googleId          String?  @unique
  appleId           String?  @unique

  lastSeenAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Subscription
  plan              SubscriptionPlan @default(basic)
  planExpiresAt     DateTime?

  // Profile UI settings
  prayerTimesEnabled        Boolean  @default(true)
  halalVerificationSubmitted Boolean  @default(false)
  // Read receipts are a premium feature with a user toggle (Module C).
  readReceiptsEnabled       Boolean  @default(true)
  showOnlineStatus          Boolean  @default(true)
  showLastSeen              Boolean  @default(false)
  showDistance              Boolean  @default(true)
  incognitoMode             Boolean  @default(false)
  profileVisibility         String   @default("everyone")

  // Usage tracking (Basic plan limits)
  likesUsedToday    Int      @default(0)
  activeChatsCount  Int      @default(0)
  lastLikeReset     DateTime @default(now())

  // Notifications read-marker: anything newer than this is "unread".
  notificationsReadAt DateTime?

  // Relations
  profile           Profile?
  onboardingAnswers OnboardingAnswer[]
  photos            Photo[]

  refreshTokens     RefreshToken[]
  emailTokens       EmailVerificationToken[]
  passwordTokens    PasswordResetToken[]
  phoneTokens       PhoneVerificationToken[]

  photoRequestsMade     PhotoAccessRequest[] @relation("PhotoRequester")
  photoRequestsReceived PhotoAccessRequest[] @relation("PhotoOwner")

  subscription      Subscription?
  transactions      Transaction[]

  devices           Device[]
  inboxMessages     InboxMessage[]
  supportTickets    SupportTicket[]

  likesGiven        Like[] @relation("LikesGiven")
  likesReceived     Like[] @relation("LikesReceived")
  matchesAsA        Match[] @relation("MatchesAsA")
  matchesAsB        Match[] @relation("MatchesAsB")

  conversationsAsA  Conversation[] @relation("ConversationsAsA")
  conversationsAsB  Conversation[] @relation("ConversationsAsB")
  messagesSent      Message[] @relation("MessagesSent")

  blocksGiven       Block[]  @relation("BlocksGiven")
  blocksReceived    Block[]  @relation("BlocksReceived")
  reportsGiven      Report[] @relation("ReportsGiven")
  reportsReceived   Report[] @relation("ReportsReceived")

  // Tasbih
  tasbihSessions    TasbihSession[]
  tasbihDailyStats  TasbihDaily[]
  tasbihStreaks     TasbihStreak[]
  userBadges        UserBadge[]
  tasbihSettings    TasbihUserSettings?

  @@index([email])
}

// ─────────────────────────────────────────────────────────────
//  PROFILE — Public matrimonial profile
// ─────────────────────────────────────────────────────────────
model Profile {
  userId            String   @id
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  gender            Gender?
  dateOfBirth       DateTime?
  city              String?
  country           String?
  profession        String?
  bio               String?  @db.Text
  primaryImageUrl   String?

  // Faith
  prayerFrequency   PrayerFrequency?
  sect              IslamicSect?
  hijabPreference   HijabPreference?

  // Lifestyle / values
  ethnicity         String?
  maritalTimeline   MarriageTimeline?
  childrenPref      ChildrenPreference?
  locationPref      LocationPreference?
  values            Json? // up to 3 strings
  interests         Json? // array of strings (tags)

  // Guardian / Wali (optional) — CC'd on chat summaries, involved on request
  waliName          String?
  waliEmail         String?
  waliPhone         String?
  waliRelation      String? // e.g. father, brother, uncle

  // Appearance & partner preferences
  hasBeard          Boolean?
  prefersBeard      Boolean?
  prefersHijab      Boolean?

  // Verification & visibility
  isVerified        Boolean  @default(false)
  isComplete        Boolean  @default(false)
  // 0–100 profile completeness, recomputed on every profile write.
  completeness      Int      @default(0)

  updatedAt         DateTime @updatedAt

  @@index([gender, country, city])
}

// ─────────────────────────────────────────────────────────────
//  ONBOARDING — raw answers from the onboarding quiz
// ─────────────────────────────────────────────────────────────
model OnboardingAnswer {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  answer     Json // string or array
  createdAt  DateTime @default(now())

  @@unique([userId, questionId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
//  PHOTOS
// ─────────────────────────────────────────────────────────────
model Photo {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean  @default(false)
  // Private/locked photos are hidden in discovery & on the public profile.
  // They become visible to a viewer only after an approved PhotoAccessRequest.
  isPrivate Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
//  PRIVATE PHOTO ACCESS — request / grant flow
// ─────────────────────────────────────────────────────────────
model PhotoAccessRequest {
  id          String   @id @default(uuid())
  requesterId String
  ownerId     String
  // pending | granted | denied
  status      String   @default("pending") @db.VarChar(16)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  requester   User     @relation("PhotoRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  owner        User    @relation("PhotoOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([requesterId, ownerId])
  @@index([ownerId])
  @@index([requesterId])
}

// ─────────────────────────────────────────────────────────────
//  LIKES & MATCHES
// ─────────────────────────────────────────────────────────────
model Like {
  id         String   @id @default(uuid())
  fromUserId String
  toUserId   String
  type       LikeType
  createdAt  DateTime @default(now())

  fromUser   User     @relation("LikesGiven", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser     User     @relation("LikesReceived", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId])
}

model Match {
  id        String   @id @default(uuid())
  userAId   String
  userBId   String
  createdAt DateTime @default(now())

  userA     User     @relation("MatchesAsA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User     @relation("MatchesAsB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

// ─────────────────────────────────────────────────────────────
//  CHAT — Conversations & Messages
// ─────────────────────────────────────────────────────────────
model Conversation {
  id            String   @id @default(uuid())
  // userAId is always the lexicographically smaller id so we can use a
  // unique pair index and never end up with two convs for one pair.
  userAId       String
  userBId       String
  userA         User     @relation("ConversationsAsA", fields: [userAId], references: [id], onDelete: Cascade)
  userB         User     @relation("ConversationsAsB", fields: [userBId], references: [id], onDelete: Cascade)
  messages      Message[]
  createdAt     DateTime @default(now())
  lastMessageAt DateTime @default(now())

  // "Involve wali": a guardian has been CC'd on this conversation summary.
  waliInvolved   Boolean   @default(false)
  waliInvolvedAt DateTime?

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@index([lastMessageAt])
}

model Message {
  id             String   @id @default(uuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User     @relation("MessagesSent", fields: [senderId], references: [id], onDelete: Cascade)
  text           String   @db.Text
  // text | image | voice — image/voice are premium-only (Module C).
  type           String   @default("text") @db.VarChar(16)
  mediaUrl       String?
  // Auto-moderation: set when the text matched the flagged-word list.
  flagged        Boolean  @default(false)
  createdAt      DateTime @default(now())
  readAt         DateTime?

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// ─────────────────────────────────────────────────────────────
//  TOKENS — refresh / email verify / password reset
// ─────────────────────────────────────────────────────────────
model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique @db.VarChar(255)
  expiresAt DateTime
  createdAt DateTime @default(now())
  revokedAt DateTime?

  @@index([userId])
}

model EmailVerificationToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code       String    @db.VarChar(6)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model PasswordResetToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  code       String    @db.VarChar(6)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model PhoneVerificationToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone      String    @db.VarChar(32)
  code       String    @db.VarChar(6)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@index([phone])
}

// ─────────────────────────────────────────────────────────────
//  SAFETY — Blocks & Reports
// ─────────────────────────────────────────────────────────────
model Block {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker   User     @relation("BlocksGiven", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Report {
  id         String   @id @default(uuid())
  reporterId String
  reportedId String
  reason     String   @db.VarChar(255)
  details    String?  @db.Text
  // Dashboard moderation metadata (optional; the mobile flow sends reason/details).
  category   String?  @db.VarChar(64)
  // low | medium | high
  severity   String   @default("low") @db.VarChar(16)
  // open | reviewed | resolved | dismissed
  status     String   @default("open") @db.VarChar(32)
  resolvedAt DateTime?
  createdAt  DateTime @default(now())

  reporter   User     @relation("ReportsGiven", fields: [reporterId], references: [id], onDelete: Cascade)
  reported   User     @relation("ReportsReceived", fields: [reportedId], references: [id], onDelete: Cascade)

  @@index([reportedId])
  @@index([reporterId])
}

// ─────────────────────────────────────────────────────────────
//  MONETIZATION — Plans, Subscriptions, Transactions
// ─────────────────────────────────────────────────────────────
// Dashboard-editable plan catalogue. `tier` maps to the SubscriptionPlan enum
// that drives feature-gating across the app; price/features/visibility are
// editable so the dashboard can change them without a deploy.
model Plan {
  id              String           @id @default(uuid())
  tier            SubscriptionPlan
  name            String
  description     String?          @db.Text
  priceCents      Int              @default(0)
  currency        String           @default("USD") @db.VarChar(8)
  // month | year | once
  interval        String           @default("month") @db.VarChar(16)
  features        Json? // string[] of marketing bullet points
  visible         Boolean          @default(true)
  sortOrder       Int              @default(0)

  // Provider product/price identifiers for real billing
  stripePriceId   String?
  appleProductId  String?
  googleProductId String?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  subscriptions   Subscription[]

  @@index([visible, sortOrder])
}

model Subscription {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId            String
  plan              Plan     @relation(fields: [planId], references: [id])

  // stripe | apple | google | manual
  provider          String   @db.VarChar(16)
  // active | canceled | expired | pending
  status            String   @default("active") @db.VarChar(16)
  // Provider subscription id / original transaction id (for receipt linking).
  externalId        String?
  currentPeriodEnd  DateTime?
  cancelAtPeriodEnd Boolean  @default(false)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
}

model Transaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId      String?
  provider    String   @db.VarChar(16)
  amountCents Int      @default(0)
  currency    String   @default("USD") @db.VarChar(8)
  // succeeded | pending | failed | refunded
  status      String   @default("succeeded") @db.VarChar(16)
  externalId  String?
  createdAt   DateTime @default(now())

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
//  DEVICES — push notification tokens (FCM / APNs)
// ─────────────────────────────────────────────────────────────
enum DevicePlatform {
  ios
  android
  web
}

model Device {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String         @unique @db.VarChar(255)
  platform  DevicePlatform
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
//  ADS — dashboard-managed promotional slots
// ─────────────────────────────────────────────────────────────
enum AdPlacement {
  HOME_BANNER
  BETWEEN_MATCHES
  CHAT_TOP
  PROFILE_SIDEBAR
}

enum AdAudience {
  ALL
  FREE
  PREMIUM
}

model Ad {
  id          String      @id @default(uuid())
  title       String
  body        String?     @db.Text
  // @db.Text so dashboard-uploaded data-URL images fit (VARCHAR(191) is too small).
  imageUrl    String?     @db.Text
  ctaText     String?
  targetUrl   String?
  placement   AdPlacement
  audience    AdAudience  @default(ALL)
  isActive    Boolean     @default(true)
  // Active window (null = open-ended on that side).
  startsAt    DateTime?
  endsAt      DateTime?
  // Lightweight analytics counters incremented by the app.
  impressions Int         @default(0)
  clicks      Int         @default(0)
  sortOrder   Int         @default(0)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([placement, isActive])
}

// ─────────────────────────────────────────────────────────────
//  INBOX — admin ↔ user messaging (from the dashboard tool)
// ─────────────────────────────────────────────────────────────
model InboxMessage {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // true = sent by an admin to the user; false = the user's reply.
  fromAdmin Boolean  @default(true)
  subject   String?
  body      String   @db.Text
  isRead    Boolean  @default(false)
  // Replies reference the root admin message so they form a thread.
  parentId  String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([parentId])
}

// ─────────────────────────────────────────────────────────────
//  SUPPORT — structured support requests separate from inbox chat
// ─────────────────────────────────────────────────────────────
model SupportTicket {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subject     String
  category    String   @default("general")
  priority    String   @default("normal")
  status      String   @default("open")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  messages    SupportTicketMessage[]

  @@index([userId, status, updatedAt])
}

model SupportTicketMessage {
  id        String        @id @default(uuid())
  ticketId  String
  ticket    SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  body      String        @db.Text
  fromAdmin Boolean       @default(false)
  createdAt DateTime      @default(now())

  @@index([ticketId, createdAt])
}

// ─────────────────────────────────────────────────────────────
//  ISLAMIC FEATURES — global dashboard toggles (singleton row id=1)
// ─────────────────────────────────────────────────────────────
model IslamicSetting {
  id                  Int      @id @default(1)
  prayerTimesEnabled  Boolean  @default(true)
  qiblaEnabled        Boolean  @default(true)
  dailyContentEnabled Boolean  @default(true)
  tasbihEnabled       Boolean  @default(true)
  ramadanMode         Boolean  @default(false)
  // Default calculation method for prayer times (MWL | ISNA | Egypt | Makkah | Karachi)
  calcMethod          String   @default("MWL") @db.VarChar(16)
  updatedAt           DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────
//  ADMIN — audit log + app settings
// ─────────────────────────────────────────────────────────────
model AuditLog {
  id         String   @id @default(uuid())
  adminId    String?
  adminEmail String?
  // e.g. "POST /admin/users/:id/status"
  action     String   @db.VarChar(255)
  // affected entity id(s), serialized
  target     String?  @db.VarChar(255)
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// Generic key/value app settings + feature flags edited from the dashboard.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Sent broadcast announcements (dashboard "Notifications" history).
model Broadcast {
  id        String   @id @default(uuid())
  title     String
  message   String   @db.Text
  // all | free | premium (the segment it targeted)
  audience  String   @default("all") @db.VarChar(16)
  // Number of users it reached at send time.
  reach     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────
//  TASBIH — Islamic counter system
// ─────────────────────────────────────────────────────────────

// Badge definitions managed by admins
model TasbihBadge {
  id          String      @id @default(uuid())
  name        String      @unique
  description String?     @db.Text
  badgeType   BadgeType
  // Badge unlocks at this count (for milestone type)
  threshold   Int?
  // Badge unlocks after N consecutive days (for streak type)
  streakDays  Int?
  // Badge icon URL
  iconUrl     String?
  // Badge color (hex code)
  color       String?     @db.VarChar(7)
  isActive    Boolean     @default(true)
  sortOrder   Int         @default(0)
  
  // Only award badge to premium users (null = all users)
  requiresPremium Boolean  @default(false)
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  userBadges  UserBadge[]

  @@index([badgeType, isActive])
}

// Individual Tasbih count entry
model TasbihSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Count in this session
  count     Int      @default(0)
  
  // When session was created (local time for daily aggregation)
  sessionDate DateTime @default(now())
  
  // Optional: prayer name or intention
  intention String?  @db.VarChar(255)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@index([userId, sessionDate])
  @@index([createdAt])
}

// Daily aggregation (to avoid expensive queries)
model TasbihDaily {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Date of the day (stored as date only, no time)
  date      DateTime @db.Date
  
  // Total Tasbih count for this day
  count     Int      @default(0)
  
  // Did user meet daily goal on this day?
  metGoal   Boolean  @default(false)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  @@unique([userId, date])
  @@index([userId, date])
}

// Streak tracking
model TasbihStreak {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Current consecutive days
  currentStreak Int      @default(0)
  
  // Longest streak ever achieved
  longestStreak Int      @default(0)
  
  // When the current streak started
  streakStartDate DateTime?
  
  // When the current streak ended (null if ongoing)
  streakEndDate DateTime?
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  @@unique([userId])
  @@index([userId])
}

// User Tasbih badges (earned/progress)
model UserBadge {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  badgeId     String
  badge       TasbihBadge @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  
  // When the badge was earned/awarded
  earnedAt    DateTime?
  
  // Current progress towards badge (0-100%)
  progress    Int      @default(0)
  
  // Locked, in_progress, earned
  status      String   @default("locked") @db.VarChar(16)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([userId, badgeId])
  @@index([userId, status])
  @@index([earnedAt])
}

// User-specific Tasbih settings
model TasbihUserSettings {
  id                  String          @id @default(uuid())
  userId              String          @unique
  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Privacy: private, matchesOnly, public
  visibility          TasbihVisibility @default(private)
  
  // Daily goal (number of tasbihs to reach)
  dailyGoal           Int             @default(100)
  
  // Enable notifications for milestones
  notificationsEnabled Boolean        @default(true)
  
  // Enable sound/haptic feedback
  soundEnabled        Boolean         @default(true)
  hapticEnabled       Boolean         @default(true)
  
  // Lifetime Tasbih count (cached for fast queries)
  lifetimeTotal       Int             @default(0)
  
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  
  @@index([userId])
}

// Admin Tasbih feature settings (singleton-like, keyed by feature)
model TasbihSettings {
  id                      String  @id @default(uuid())
  
  // Enable/disable features
  badgesEnabled           Boolean @default(true)
  streaksEnabled          Boolean @default(true)
  leaderboardEnabled      Boolean @default(true)
  dailyGoalEnabled        Boolean @default(true)
  encouragementEnabled    Boolean @default(true)
  
  // Default daily goal for new users
  defaultDailyGoal        Int     @default(100)
  
  // Min days for streak achievement
  minStreakDays           Int     @default(7)
  
  // Leaderboard scope: global | country | city | matches
  leaderboardScope        String  @default("global") @db.VarChar(32)
  
  // Encouragement messages (JSON array)
  encouragementMessages   Json?
  
  updatedAt               DateTime @updatedAt
}

// Leaderboard cache (updated periodically)
model TasbihLeaderboard {
  id            String   @id @default(uuid())
  userId        String
  
  // Ranking scope (global, country, etc.)
  scope         String   @db.VarChar(32)
  
  // Rank in this scope
  rank          Int
  
  // User's lifetime count
  lifetimeCount Int
  
  // User's current streak
  currentStreak Int
  
  // For sorting/pagination
  score         Int
  
  updatedAt     DateTime @updatedAt
  
  @@unique([userId, scope])
  @@index([scope, rank])
  @@index([updatedAt])
}

