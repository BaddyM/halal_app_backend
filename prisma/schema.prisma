generator client {
    provider = "prisma-client-js"
    //   output   = "../generated/prisma"
}

datasource db {
    provider = "mysql"
    url      = env("DATABASE_URL")
}

model User {
    id             String          @id @default(uuid())
    name           String
    email          String          @unique
    password       String
    role           Role
    profilePicture String?
    isActive       Boolean         @default(false)
    accessToken    String?
    fcmToken       String?
    Stock          Stock[]
    Order          Order[]
    Service        Service[]
    Payment        Payment[]
    Expense        Expense[]
    Staff          Staff[]
    Notifications  Notifications[]
    createdAt      DateTime        @default(now())
    updatedAt      DateTime        @updatedAt
    Attendance     Attendance[]
    Banking        Banking[]
    Reports        Reports[]
}

model Attendance {
    id        String           @id @default(uuid())
    userId    String
    user      User             @relation(fields: [userId], references: [id])
    status    AttendanceStatus @default(PRESENT)
    memo      String?          @db.LongText
    createdAt DateTime         @default(now())
    updatedAt DateTime         @updatedAt
}

enum AttendanceStatus {
    PRESENT
    ABSENT
}

enum Role {
    ADMIN
    BAR
    BAR2
    SAUNA
    PARKING
    KITCHEN
}

model Table {
    id        String      @id @default(uuid())
    name      String
    status    TableStatus @default(FREE)
    createdAt DateTime    @default(now())
    updatedAt DateTime    @updatedAt
}

enum TableStatus {
    TAKEN
    FREE
}

model Order {
    id            String      @id @default(uuid())
    customer      String?
    table         String
    itemId        String
    item          Stock       @relation(fields: [itemId], references: [id])
    qty           Int         @default(1)
    status        OrderStatus @default(PENDING)
    kitchenStatus OrderStatus @default(PENDING)
    orderType     OrderType   @default(BAR)
    Payment       Payment[]
    userId        String
    user          User        @relation(fields: [userId], references: [id])
    createdAt     DateTime    @default(now())
    updatedAt     DateTime    @updatedAt
}

enum OrderType {
    KITCHEN
    BAR
}

enum OrderStatus {
    PENDING
    SERVED
    PREPARING
    READY
    CANCELLED
}

model Service {
    id          String        @id @default(uuid())
    userId      String
    user        User          @relation(fields: [userId], references: [id])
    customer    String?
    phoneNumber String?
    service     ServiceList
    Payment     Payment[]
    amount      Int           @default(0)
    status      ServiceStatus @default(PENDING)
    duration    String
    memo        String?       @db.LongText
    createdAt   DateTime      @default(now())
    updatedAt   DateTime      @updatedAt
}

enum ServiceList {
    SAUNA
    PARKING
    GARDENS
    ACCOMODATION
    OTHER
}

enum ServiceStatus {
    PAID
    PENDING
    CANCELLED
}

model Payment {
    id        String        @id @default(uuid())
    userId    String
    user      User          @relation(fields: [userId], references: [id])
    orderId   String?
    order     Order?        @relation(fields: [orderId], references: [id])
    serviceId String?
    service   Service?      @relation(fields: [serviceId], references: [id])
    paid      Int           @default(0)
    status    PaymentStatus @default(PENDING)
    createdAt DateTime      @default(now())
    updatedAt DateTime      @updatedAt
}

enum PaymentStatus {
    PENDING
    CANCELLED
    PAID
}

model Stock {
    id           String         @id @default(uuid())
    userId       String
    user         User           @relation(fields: [userId], references: [id])
    item         String         @unique
    category     StockCategory
    qty          Int            @default(1)
    UnitPrice    Int            @default(0)
    image        String?
    status       StockStatus    @default(AVAILABLE)
    Order        Order[]
    StockHistory StockHistory[]
    createdAt    DateTime       @default(now())
    updatedAt    DateTime       @updatedAt
}

model StockHistory {
    id        String   @id @default(uuid())
    itemId    String
    item      Stock    @relation(fields: [itemId], references: [id])
    qty       Int
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

enum StockCategory {
    PRODUCE
    DRINKS
    FOOD
    MEAT
    DRY_GOODS
    OTHERS
}

enum StockStatus {
    AVAILABLE
    OUT_OF_STOCK
    LOW_STOCK
}

model Expense {
    id        String   @id @default(uuid())
    item      String
    amount    Int      @default(0)
    userId    String
    user      User     @relation(fields: [userId], references: [id])
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Banking {
    id        String      @id @default(uuid())
    amount    Int         @default(0)
    userId    String
    user      User        @relation(fields: [userId], references: [id])
    type      BankingType @default(DEPOSIT)
    memo      String?     @db.LongText
    createdAt DateTime    @default(now())
    updatedAt DateTime    @updatedAt
}

enum BankingType {
    WITHDRAW
    DEPOSIT
}

model Staff {
    id         String          @id @default(uuid())
    name       String
    baseSalary Int             @default(0)
    role       String
    payPeriod  DateTime?
    userId     String
    user       User            @relation(fields: [userId], references: [id])
    salary     SalaryPayment[]
    createdAt  DateTime        @default(now())
    updatedAt  DateTime        @updatedAt
}

model SalaryPayment {
    id         String   @id @default(uuid())
    staffId    String
    staff      Staff    @relation(fields: [staffId], references: [id])
    amountPaid Int      @default(0)
    period     String
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt
}

enum StaffPaymentStatus {
    PENDING
    PAID
    FAILED
}

model Notifications {
    id        String   @id @default(uuid())
    title     String
    message   String
    to        String
    userId    String
    user      User     @relation(fields: [userId], references: [id])
    read      Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Reports {
    id        String   @id @default(uuid())
    userId    String
    user      User     @relation(fields: [userId], references: [id])
    title     String
    report    String   @db.LongText
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

//Website
model WebsiteGallery {
    id          String   @id @default(uuid())
    title       String
    description String?
    image       String   @db.LongText
    section     String?
    isActive    Boolean  @default(false)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}

model WebsiteBlog {
    id          String   @id @default(uuid())
    title       String
    description String?  @db.LongText
    image       String   @db.LongText
    section     String?
    isActive    Boolean  @default(false)
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt
}

model WebsiteContact {
    id             String   @id @default(uuid())
    fname          String
    lname          String
    email          String?
    phone          String
    serviceNeeded  String
    eventDate      String?
    message        String   @db.LongText
    expectedGuests String
    isRead         Boolean  @default(false)
    createdAt      DateTime @default(now())
    updatedAt      DateTime @updatedAt
}

model WebsiteTestimonies {
    id        String   @id @default(uuid())
    name      String
    title     String
    stars     Int
    message   String   @db.LongText
    isActive  Boolean  @default(false)
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
