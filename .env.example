# Core
DATABASE_URL=mysql://halal_user:replace_with_strong_password@mysql:3306/halal_db
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
# SYSTEM_SECRET is supported as a legacy alias for JWT_SECRET.
MODE=Dev
PORT=3000
APP_NAME=Halal Dating
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,https://admin.halalconnect.space

# Encrypted payment settings (32-byte key, encoded as hex or base64).
# PAYMENT_CONFIG_ENCRYPTION_KEY remains a supported legacy alias.
PAYMENT_KEYS_ENCRYPTION_KEY=

# SMTP / email delivery
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_FROM_NAME=Halalconnect

# Optional admin bootstrap
ADMIN_EMAILS=admin@example.com

# Gemini AI support assistant
GEMINI_API_KEY=replace_with_google_ai_studio_key
GEMINI_MODEL=gemini-2.0-flash
GEMINI_PER_MINUTE_LIMIT=60
GEMINI_DAILY_LIMIT=1000

# Firebase Cloud Messaging (push notifications)
# Either point at the service-account JSON fileâ€¦
FIREBASE_SERVICE_ACCOUNT_PATH=./config/halal-connect-6504d.json
# â€¦or inline the whole JSON on one line (preferred for hosted deploys):
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# â”€â”€ Billing webhook verification â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# These endpoints grant paid plans. Verification FAILS CLOSED: if the value
# for a provider is unset, that provider's webhook rejects every request.
# Stripe: Dashboard â†’ Developers â†’ Webhooks â†’ signing secret (whsec_...)
STRIPE_WEBHOOK_SECRET=
# Apple: PEM of "Apple Root CA - G3", used to pin the App Store Server
# Notification v2 signing chain. Download from apple.com/certificateauthority
APPLE_ROOT_CA_PEM=
# Google Play RTDN â€” set EITHER of these. The token is the `?token=` value
# configured on the Pub/Sub push subscription; the audience is used instead
# when the subscription authenticates with an OIDC service account.
GOOGLE_PUBSUB_VERIFICATION_TOKEN=
GOOGLE_PUBSUB_OIDC_AUDIENCE=
# Local development only: skips webhook verification. Requires MODE=Dev too,
# so it cannot be switched on accidentally in production.
ALLOW_UNVERIFIED_WEBHOOKS=false

MYSQL_ROOT_PASSWORD=replace_with_a_strong_unique_password